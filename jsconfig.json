{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "react": [
        "packages/react"
      ],
      "react/*": [
        "packages/react/*"
      ],
      "react-dom": [
        "packages/react-dom"
      ],
      "react-dom/*": [
        "packages/react-dom/*"
      ],
      "react-dom-bindings": [
        "packages/react-dom-bindings"
      ],
      "react-dom-bindings/*": [
        "packages/react-dom-bindings/*"
      ],
      "react-reconciler": [
        "packages/react-reconciler"
      ],
      "react-reconciler/*": [
        "packages/react-reconciler/*"
      ],
      "scheduler": [
        "packages/scheduler"
      ],
      "scheduler/*": [
        "packages/scheduler/*"
      ],
      "shared": [
        "packages/shared"
      ],
      "shared/*": [
        "packages/shared/*"
      ],
      "@/*": [
        "*"
      ]
    }
  },
  "exclude": [
    "node_modules"
  ]
}